# NFS-e Nacional. Mantenha certificado e senha no .env local.
DATABASE_URL=postgresql+psycopg://clinicaflow:troque-esta-senha@localhost:5432/clinicaflow
NFSE_ENV=restricted
# Base oficial da SEFIN; nfse.gov.br é o portal web.
# NFSE_BASE_URL=https://sefin.producaorestrita.nfse.gov.br/SefinNacional
# Caminho completo do certificado A1 (.pfx ou .p12), fora do repositório.
NFSE_PFX_PATH=
NFSE_PFX_PASSWORD=
NFSE_DPS_SCHEMA_PATH=schemas/nfse/producao-restrita/DPS_v1.01.xsd
NFSE_OUTPUT_DIR=var/nfse
NFSE_TIMEOUT_SECONDS=30

# Preencha localmente com os dados fiscais confirmados pela contabilidade.
# Dados oficiais do prestador; confirme com a contabilidade.
NFSE_PROVIDER_CNPJ=
NFSE_PROVIDER_LEGAL_NAME=
# Opcional se o prestador tiver inscricao municipal.
NFSE_PROVIDER_MUNICIPAL_REGISTRATION=
NFSE_PROVIDER_STREET=
NFSE_PROVIDER_NUMBER=
NFSE_PROVIDER_COMPLEMENT=
NFSE_PROVIDER_DISTRICT=
# CEP somente numeros. UF com duas letras (por exemplo, SP).
NFSE_PROVIDER_POSTAL_CODE=
NFSE_PROVIDER_CITY=
NFSE_PROVIDER_STATE=
# Codigo IBGE do municipio do prestador.
NFSE_PROVIDER_MUNICIPALITY_CODE=

# 1 = não optante; 2 = optante MEI; 3 = optante ME/EPP.
# Simples Nacional: 1 = nao optante; 2 = MEI; 3 = ME/EPP. Confirme com a contabilidade.
NFSE_PROVIDER_SIMPLE_NATIONAL=
# Só preencha conforme orientação contábil, se aplicável (1, 2 ou 3).
# Codigo do regime tributario, se aplicavel; confirme com a contabilidade.
NFSE_PROVIDER_SIMPLE_TAX_REGIME=
# Regime especial municipal (0 = nenhum); confirme com a contabilidade.
NFSE_PROVIDER_SPECIAL_TAX_REGIME=
# Serie numerica exclusiva para DPS emitidas por esta aplicacao.
NFSE_DPS_SERIES=
# Token privado obrigatorio para a rota de emissao.
NFSE_EMISSION_TOKEN=

# Código de Tributação Nacional/municipal de cada serviço.
# Consulte a parametrização do município; não use um código presumido.
# Preencha apenas os servicos oferecidos; confirme cada codigo para o municipio.
# NFSE_SERVICE_CODE_* guarda cTribNac (seis digitos); cTribMun fica separado abaixo.
# Psicologia: 041601; psicotecnicos e pericia: 170901 (item 17.09).
NFSE_SERVICE_CODE_PSYCHOLOGY=
NFSE_SERVICE_CODE_PSYCHOTECHNIC_DETRAN=
NFSE_SERVICE_CODE_PSYCHOTECHNIC_PF=
NFSE_SERVICE_CODE_TOXICOLOGICAL_ANALYSIS=
NFSE_SERVICE_CODE_TOXICOLOGICAL_COLLECTION=
NFSE_SERVICE_CODE_PSYCHIATRY=
NFSE_SERVICE_CODE_FORENSIC_REPORT=
NFSE_SERVICE_MUNICIPAL_CODE_PSYCHOLOGY=
NFSE_SERVICE_MUNICIPAL_CODE_PSYCHOTECHNIC_DETRAN=
NFSE_SERVICE_MUNICIPAL_CODE_PSYCHOTECHNIC_PF=
NFSE_SERVICE_MUNICIPAL_CODE_TOXICOLOGICAL_ANALYSIS=
NFSE_SERVICE_MUNICIPAL_CODE_TOXICOLOGICAL_COLLECTION=
NFSE_SERVICE_MUNICIPAL_CODE_PSYCHIATRY=
NFSE_SERVICE_MUNICIPAL_CODE_FORENSIC_REPORT=
